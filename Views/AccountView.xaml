<Window x:Class="course_project_shop_musical_instruments.Views.AccountView"
        x:Name="AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:course_project_shop_musical_instruments.Helpers"
        mc:Ignorable="d"
        Title="Мой профиль"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F5F5F5">
    <Window.Resources>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <helpers:StatusConverter x:Key="StatusConverter"/>
        <helpers:OrderCancelVisibilityConverter x:Key="OrderCancelVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:ColorZone Grid.Row="0" 
                                  materialDesign:ShadowAssist.ShadowDepth="Depth2"
                                  Padding="20" 
                                  Mode="PrimaryMid">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Account" Width="32" Height="32" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="White"/>
                    <TextBlock Text="Мой профиль" 
                               FontSize="24" FontWeight="Bold" 
                               Foreground="White" 
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding NavigateToCatalogCommand}" 
                            Margin="0,0,10,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Music" Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Каталог"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateToCartCommand}" 
                            Margin="0,0,10,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cart" Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Корзина"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LogoutCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Background="#E74C3C">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Выход"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Profile Information -->
            <materialDesign:Card Grid.Column="0" 
                                 materialDesign:ShadowAssist.ShadowDepth="Depth2"
                                 Padding="20" 
                                 Background="White"
                                 Margin="0,0,20,0">
                <StackPanel>
                    <TextBlock Text="Информация о профиле" 
                               FontSize="18" FontWeight="Bold" 
                               Margin="0,0,0,20"
                               Foreground="#2C3E50"/>

                    <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="Email:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding CurrentUser.Email}" Margin="0,0,0,15"/>

                        <TextBlock Text="Имя:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding CurrentUser.FirstName}" Margin="0,0,0,15"/>

                        <TextBlock Text="Фамилия:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding CurrentUser.LastName}" Margin="0,0,0,15"/>

                        <TextBlock Text="Телефон:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding CurrentUser.Phone, TargetNullValue='Не указан'}" Margin="0,0,0,15"/>

                        <TextBlock Text="Адрес:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding CurrentUser.Address, TargetNullValue='Не указан'}" Margin="0,0,0,20" TextWrapping="Wrap"/>

                        <Button Command="{Binding EditProfileCommand}" 
                                Content="Редактировать профиль" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Edit Mode -->
                    <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Email"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,15"
                                 FontSize="14"/>

                        <TextBox x:Name="FirstNameEditTextBox"
                                 Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Имя"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,15"
                                 FontSize="14"
                                 PreviewTextInput="FirstNameEditTextBox_PreviewTextInput"
                                 DataObject.Pasting="FirstNameEditTextBox_Pasting"/>

                        <TextBox x:Name="LastNameEditTextBox"
                                 Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Фамилия"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,15"
                                 FontSize="14"
                                 PreviewTextInput="LastNameEditTextBox_PreviewTextInput"
                                 DataObject.Pasting="LastNameEditTextBox_Pasting"/>

                        <TextBox x:Name="PhoneEditTextBox"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Телефон"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,15"
                                 FontSize="14"
                                 MaxLength="13"
                                 PreviewTextInput="PhoneEditTextBox_PreviewTextInput"
                                 DataObject.Pasting="PhoneEditTextBox_Pasting"/>

                        <TextBox x:Name="AddressEditTextBox"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Адрес"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,15"
                                 FontSize="14"
                                 PreviewTextInput="AddressEditTextBox_PreviewTextInput"
                                 DataObject.Pasting="AddressEditTextBox_Pasting"/>

                        <PasswordBox x:Name="PasswordBox" 
                                     materialDesign:HintAssist.Hint="Новый пароль (оставьте пустым, чтобы не менять)"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     Margin="0,0,0,15"
                                     FontSize="14"/>

                        <PasswordBox x:Name="ConfirmPasswordBox" 
                                     materialDesign:HintAssist.Hint="Подтвердите пароль"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     Margin="0,0,0,20"
                                     FontSize="14"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CancelEditCommand}" 
                                    Content="Отмена" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="0,0,10,0"/>
                            <Button Command="{Binding SaveProfileCommand}" 
                                    Content="Сохранить" 
                                    Style="{StaticResource MaterialDesignRaisedButton}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Orders History -->
            <materialDesign:Card Grid.Column="1" 
                                 materialDesign:ShadowAssist.ShadowDepth="Depth2"
                                 Padding="20" 
                                 Background="White">
                <StackPanel>
                    <TextBlock Text="История заказов" 
                               FontSize="18" FontWeight="Bold" 
                               Margin="0,0,0,20"
                               Foreground="#2C3E50"/>

                    <DataGrid ItemsSource="{Binding Orders}" 
                              SelectedItem="{Binding SelectedOrder}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              SelectionMode="Single"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер заказа" Binding="{Binding Id}" Width="100"/>
                            <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="150"/>
                            <DataGridTextColumn Header="Дата доставки" Binding="{Binding DeliveryDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="120"/>
                            <DataGridTemplateColumn Header="Время доставки" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <Binding Path="DeliveryTime" StringFormat="{}{0:hh\:mm}"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat='{}{0:N2} BYN'}" Width="120"/>
                            <DataGridTemplateColumn Header="Статус" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Действие" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.CancelOrderCommand, ElementName=AccountWindow}"
                                                CommandParameter="{Binding}"
                                                Content="Отменить"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#E74C3C"
                                                Padding="10,5"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding Status, Converter={StaticResource OrderCancelVisibilityConverter}}"
                                                ToolTip="Отменить заказ"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Order Details -->
                    <materialDesign:Card materialDesign:ShadowAssist.ShadowDepth="Depth1"
                                         Padding="20" 
                                         Margin="0,20,0,0"
                                         Background="White"
                                         Visibility="{Binding SelectedOrder, Converter={StaticResource NullToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                            <StackPanel>
                                <TextBlock Text="Детали заказа" 
                                           FontSize="18" FontWeight="Bold" 
                                           Margin="0,0,0,15"
                                           Foreground="#2C3E50"/>
                                <TextBlock Text="{Binding SelectedOrder.Id, StringFormat='Номер заказа: #{0}'}" 
                                           FontWeight="SemiBold" 
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding SelectedOrder.OrderDate, StringFormat='Дата заказа: {0:dd.MM.yyyy HH:mm}'}" 
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding SelectedOrder.DeliveryDate, StringFormat='Дата доставки: {0:dd.MM.yyyy}'}" 
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding SelectedOrder.DeliveryTime, StringFormat='Время доставки: {0:hh\\:mm}'}" 
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding SelectedOrder.TotalAmount, StringFormat='Сумма: {0:N2} BYN'}" 
                                           FontWeight="SemiBold" 
                                           Margin="0,0,0,15"
                                           Foreground="#27AE60"/>
                                
                                <TextBlock Text="Товары:" 
                                           FontWeight="SemiBold" 
                                           Margin="0,10,0,5"/>
                                <ItemsControl ItemsSource="{Binding SelectedOrder.OrderItems, TargetNullValue={x:Null}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="10,0,0,5">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="• {0} x{1} - {2:N2} BYN">
                                                        <Binding Path="Product.Name" TargetNullValue="Товар удален" FallbackValue="Товар удален"/>
                                                        <Binding Path="Quantity"/>
                                                        <Binding Path="Subtotal" Mode="OneWay"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedOrder.OrderItems}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedOrder.OrderItems.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                </ItemsControl>
                                <TextBlock Text="Нет товаров в заказе" 
                                           Foreground="#7F8C8D"
                                           FontStyle="Italic"
                                           Margin="10,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedOrder.OrderItems}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedOrder.OrderItems.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </materialDesign:Card>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>

