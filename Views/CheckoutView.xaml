<Window x:Class="course_project_shop_musical_instruments.Views.CheckoutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:helpers="clr-namespace:course_project_shop_musical_instruments.Helpers"
        mc:Ignorable="d"
        Title="Оформление заказа"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F5F5F5">
    <Window.Resources>
        <helpers:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Order Form -->
        <materialDesign:Card Grid.Column="0" 
                             materialDesign:ShadowAssist.ShadowDepth="Depth2"
                             Padding="25" 
                             Background="White"
                             Margin="0,0,20,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <materialDesign:PackIcon Kind="Shopping" Width="32" Height="32" Margin="0,0,15,0" Foreground="#673AB7"/>
                        <TextBlock Text="Оформление заказа" 
                                   FontSize="24" FontWeight="Bold" 
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Text="Дата доставки:" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,8"
                               Foreground="#34495E"/>
                    <DatePicker SelectedDate="{Binding DeliveryDate}" 
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                Margin="0,0,0,25"
                                DisplayDateStart="{x:Static sys:DateTime.Today}"
                                DisplayDateEnd="{Binding MaxDeliveryDate, Mode=OneWay}">
                        <DatePicker.BlackoutDates>
                            <CalendarDateRange Start="{x:Static sys:DateTime.MinValue}" 
                                               End="{x:Static sys:DateTime.Today}"/>
                        </DatePicker.BlackoutDates>
                    </DatePicker>
                    
                    <TextBlock Text="Время доставки:" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,8"
                               Foreground="#34495E"/>
                    <ComboBox ItemsSource="{Binding DeliveryTimeOptions}"
                              SelectedItem="{Binding DeliveryTime}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="Выберите время доставки"
                              Margin="0,0,0,25">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource TimeSpanToStringConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.Resources>
                            <DataTemplate DataType="{x:Type sys:TimeSpan}">
                                <TextBlock Text="{Binding Converter={StaticResource TimeSpanToStringConverter}}"/>
                            </DataTemplate>
                        </ComboBox.Resources>
                    </ComboBox>
                    
                    <TextBlock Text="Адрес доставки:" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,8"
                               Foreground="#34495E"/>
                    <TextBox x:Name="DeliveryAddressTextBox"
                             Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Введите адрес доставки"
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             Height="100"
                             Margin="0,0,0,25"
                             PreviewTextInput="DeliveryAddressTextBox_PreviewTextInput"
                             DataObject.Pasting="DeliveryAddressTextBox_Pasting">
                        <Validation.ErrorTemplate>
                            <ControlTemplate>
                                <StackPanel>
                                    <AdornedElementPlaceholder/>
                                    <TextBlock Text="{Binding [0].ErrorContent}" 
                                               Foreground="Red" 
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               MaxWidth="350"
                                               Visibility="{Binding [0].ErrorContent, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </ControlTemplate>
                        </Validation.ErrorTemplate>
                    </TextBox>
                    
                    <TextBlock Text="Примечания (необязательно):" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,5"
                               Foreground="#34495E"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Дополнительная информация"
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             Height="120"
                             Margin="0,0,0,25"/>
                    
                    <Button Command="{Binding PlaceOrderCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#27AE60"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Height="50"
                            FontSize="16">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircle" Width="24" Height="24" Margin="0,0,10,0"/>
                            <TextBlock Text="Оформить заказ" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>

        <!-- Order Summary -->
        <materialDesign:Card Grid.Column="1" 
                             materialDesign:ShadowAssist.ShadowDepth="Depth2"
                             Padding="25" 
                             Background="White">
            <StackPanel>
                <TextBlock Text="Ваш заказ" 
                           FontSize="20" FontWeight="Bold" 
                           Margin="0,0,0,20"
                           Foreground="#2C3E50"/>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                    <ItemsControl ItemsSource="{Binding CartItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" 
                                        Padding="0,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Product.Name}" 
                                                       FontWeight="SemiBold"
                                                       FontSize="14"/>
                                            <TextBlock Text="{Binding Quantity, StringFormat='Количество: {0}'}" 
                                                       FontSize="12" 
                                                       Foreground="#7F8C8D"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Subtotal, StringFormat='{}{0:N2} BYN', Mode=OneWay}" 
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="#27AE60"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <Border BorderBrush="#E0E0E0" BorderThickness="0,2,0,0" 
                        Padding="0,15,0,0" Margin="0,15,0,20">
                    <TextBlock Text="{Binding Total, StringFormat='Итого: {0:N2} BYN'}" 
                               FontSize="20" FontWeight="Bold"
                               Foreground="#2C3E50"/>
                </Border>
                
                <Button Command="{Binding NavigateToCartCommand}" 
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        materialDesign:ButtonAssist.CornerRadius="5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="Вернуться в корзину"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
