<UserControl x:Class="course_project_shop_musical_instruments.Views.AdminProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:course_project_shop_musical_instruments.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200">
    <UserControl.Resources>
        <helpers:EditModeConverter x:Key="EditModeConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <helpers:StatusConverter x:Key="StatusConverter"/>
        <helpers:OrderDeleteVisibilityConverter x:Key="OrderDeleteVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Products List -->
        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <Button Content="Добавить товар" Command="{Binding AddNewProductCommand}" 
                    Margin="0,0,0,15" Padding="15,8" HorizontalAlignment="Left"
                    Background="#27AE60" Foreground="White" 
                    BorderThickness="0" Cursor="Hand"/>
            
            <DataGrid ItemsSource="{Binding Products}" 
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="All"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150"/>
                    <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="150"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat='{}{0:N2} BYN'}" Width="100"/>
                    <DataGridTextColumn Header="Остаток" Binding="{Binding StockQuantity}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Доступен" Binding="{Binding IsAvailable}" Width="80"/>
                    <DataGridTemplateColumn Header="Действия" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Редактировать" 
                                            Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,5,0" Padding="8,4" FontSize="11"
                                            Background="#3498DB" Foreground="White" 
                                            BorderThickness="0"/>
                                    <Button Content="Удалить" 
                                            Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4" FontSize="11"
                                            Background="#E74C3C" Foreground="White" 
                                            BorderThickness="0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- Product Form -->
        <Border Grid.Column="1" BorderBrush="#BDC3C7" BorderThickness="1" 
                Padding="20" Background="#ECF0F1">
            <StackPanel>
                <TextBlock Text="{Binding IsEditMode, Converter={StaticResource EditModeConverter}}" 
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <TextBlock Text="Название:" FontWeight="SemiBold" Margin="0,5,0,5"/>
                <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=False, ValidatesOnExceptions=False, NotifyOnValidationError=False}" 
                         Margin="0,0,0,10" Padding="8"/>
                
                <TextBlock Text="Описание:" FontWeight="SemiBold" Margin="0,5,0,5"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=False, ValidatesOnExceptions=False, NotifyOnValidationError=False}" 
                         Margin="0,0,0,10" Padding="8" 
                         TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                
                <TextBlock Text="Цена:" FontWeight="SemiBold" Margin="0,5,0,5"/>
                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=False, ValidatesOnExceptions=False, NotifyOnValidationError=False}" 
                         Margin="0,0,0,10" Padding="8"
                         PreviewTextInput="PriceTextBox_PreviewTextInput"
                         DataObject.Pasting="PriceTextBox_Pasting"/>
                
                <TextBlock Text="Количество на складе:" FontWeight="SemiBold" Margin="0,5,0,5"/>
                <TextBox Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=False, ValidatesOnExceptions=False, NotifyOnValidationError=False}" 
                         Margin="0,0,0,10" Padding="8"
                         PreviewTextInput="StockQuantityTextBox_PreviewTextInput"
                         DataObject.Pasting="StockQuantityTextBox_Pasting"/>
                
                <TextBlock Text="Категория:" FontWeight="SemiBold" Margin="0,5,0,5"/>
                <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=False, ValidatesOnExceptions=False, NotifyOnValidationError=False}" 
                         Margin="0,0,0,10" Padding="8"/>
                
                <TextBlock Text="Производитель:" FontWeight="SemiBold" Margin="0,5,0,5"/>
                <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=False, ValidatesOnExceptions=False, NotifyOnValidationError=False}" 
                         Margin="0,0,0,10" Padding="8"/>
                
                <TextBlock Text="Артикул:" FontWeight="SemiBold" Margin="0,5,0,5"/>
                <TextBox Text="{Binding ArticleNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=False, ValidatesOnExceptions=False, NotifyOnValidationError=False}" 
                         Margin="0,0,0,10" Padding="8"/>
                
                <TextBlock Text="Путь к изображению:" FontWeight="SemiBold" Margin="0,5,0,5"/>
                <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=False, ValidatesOnExceptions=False, NotifyOnValidationError=False}" 
                         Margin="0,0,0,10" Padding="8"/>
                
                <CheckBox Content="Доступен" IsChecked="{Binding IsAvailable}" 
                          Margin="0,0,0,15"/>
                
                <Button Command="{Binding SaveProductCommand}" 
                        IsEnabled="{Binding IsSaveEnabled}"
                        Padding="15,10" FontSize="16" FontWeight="SemiBold"
                        Background="#27AE60" Foreground="White" 
                        BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Сохранить"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Content" Value="Сохранить изменения"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
