<Window x:Class="course_project_shop_musical_instruments.Views.CatalogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:course_project_shop_musical_instruments.Helpers"
        mc:Ignorable="d"
        Title="Каталог товаров"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F5F5F5">
    <Window.Resources>
        <helpers:ImagePathConverter x:Key="ImagePathConverter"/>
        <helpers:ImageConverter x:Key="ImageConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <helpers:SortOptionConverter x:Key="SortOptionConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:ColorZone Grid.Row="0" 
                                  materialDesign:ShadowAssist.ShadowDepth="Depth2"
                                  Padding="20" 
                                  Mode="PrimaryMid">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Music" Width="32" Height="32" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Каталог музыкальных инструментов" 
                               FontSize="24" FontWeight="Bold" 
                               Foreground="White" 
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Кнопки для авторизованных пользователей -->
                    <Button Command="{Binding NavigateToCartCommand}" 
                            Margin="0,0,10,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cart" Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Корзина"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateToAccountCommand}" 
                            Margin="0,0,10,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Account" Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Мой профиль"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LogoutCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Background="#E74C3C"
                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Выход"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Кнопки для гостей -->
                    <Button Command="{Binding NavigateToLoginCommand}" 
                            Margin="0,0,10,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Background="#3498DB"
                            Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Login" Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Войти"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateToRegisterCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Background="#27AE60"
                            Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlus" Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Регистрация"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Filters -->
            <materialDesign:Card Grid.Column="0" 
                                 materialDesign:ShadowAssist.ShadowDepth="Depth1"
                                 Padding="20" 
                                 Margin="0,0,20,0"
                                 Background="White">
                <StackPanel>
                    <TextBlock Text="Фильтры" 
                               FontSize="20" FontWeight="Bold" 
                               Margin="0,0,0,20"
                               Foreground="#2C3E50"/>
                    
                    <TextBlock Text="Поиск:" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,5"
                               Foreground="#34495E"/>
                    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Введите название..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    
                    <TextBlock Text="Категория:" 
                               FontWeight="SemiBold" 
                               Margin="0,15,0,5"
                               Foreground="#34495E"/>
                    <ComboBox ItemsSource="{Binding Categories}" 
                              SelectedItem="{Binding SelectedCategory}" 
                              materialDesign:HintAssist.Hint="Выберите категорию"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                    
                    <TextBlock Text="Производитель:" 
                               FontWeight="SemiBold" 
                               Margin="0,15,0,5"
                               Foreground="#34495E"/>
                    <ComboBox ItemsSource="{Binding Manufacturers}" 
                              SelectedItem="{Binding SelectedManufacturer}" 
                              materialDesign:HintAssist.Hint="Выберите производителя"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                    
                    <TextBlock Text="Цена от:" 
                               FontWeight="SemiBold" 
                               Margin="0,15,0,5"
                               Foreground="#34495E"/>
                    <TextBox materialDesign:HintAssist.Hint="0"
                             PreviewTextInput="PriceTextBox_PreviewTextInput"
                             DataObject.Pasting="PriceTextBox_Pasting"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}">
                        <TextBox.Text>
                            <Binding Path="MinPrice" UpdateSourceTrigger="PropertyChanged" TargetNullValue="" ValidatesOnDataErrors="True">
                                <Binding.ValidationRules>
                                    <helpers:OptionalPriceValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                        <Validation.ErrorTemplate>
                            <ControlTemplate>
                                <StackPanel>
                                    <AdornedElementPlaceholder/>
                                    <TextBlock Text="{Binding [0].ErrorContent}" 
                                               Foreground="Red" 
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               MaxWidth="250"
                                               Visibility="{Binding [0].ErrorContent, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </ControlTemplate>
                        </Validation.ErrorTemplate>
                    </TextBox>
                    
                    <TextBlock Text="Цена до:" 
                               FontWeight="SemiBold" 
                               Margin="0,15,0,5"
                               Foreground="#34495E"/>
                    <TextBox materialDesign:HintAssist.Hint="100000"
                             PreviewTextInput="PriceTextBox_PreviewTextInput"
                             DataObject.Pasting="PriceTextBox_Pasting"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}">
                        <TextBox.Text>
                            <Binding Path="MaxPrice" UpdateSourceTrigger="PropertyChanged" TargetNullValue="" ValidatesOnDataErrors="True">
                                <Binding.ValidationRules>
                                    <helpers:OptionalPriceValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                        <Validation.ErrorTemplate>
                            <ControlTemplate>
                                <StackPanel>
                                    <AdornedElementPlaceholder/>
                                    <TextBlock Text="{Binding [0].ErrorContent}" 
                                               Foreground="Red" 
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               MaxWidth="250"
                                               Visibility="{Binding [0].ErrorContent, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </ControlTemplate>
                        </Validation.ErrorTemplate>
                    </TextBox>
                    
                    <Button Command="{Binding ApplyFiltersCommand}" 
                            Margin="0,20,0,10" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#27AE60"
                            materialDesign:ButtonAssist.CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Filter" Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Применить"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearFiltersCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Сбросить"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </materialDesign:Card>

            <!-- Products Grid -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Sort Block -->
                <materialDesign:Card Grid.Row="0"
                                     materialDesign:ShadowAssist.ShadowDepth="Depth1"
                                     Padding="15" 
                                     Margin="0,0,0,20"
                                     Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Sort" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Сортировка:" 
                                       FontSize="16" FontWeight="SemiBold" 
                                       VerticalAlignment="Center"
                                       Foreground="#2C3E50"/>
                        </StackPanel>
                        
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding SortOptions}" 
                                  SelectedItem="{Binding SelectedSortOption}" 
                                  materialDesign:HintAssist.Hint="Выберите сортировку"
                                  Margin="20,0"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource SortOptionConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding Products.Count, StringFormat='Товаров: {0}'}" 
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="#7F8C8D"/>
                    </Grid>
                </materialDesign:Card>
                
                <!-- Products List -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,10,0">
                    <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card 
                                materialDesign:ShadowAssist.ShadowDepth="Depth2"
                                Width="280" 
                                Height="450"
                                Margin="5" 
                                Background="White"
                                Cursor="Hand"
                                MouseLeftButtonDown="ProductCard_MouseLeftButtonDown">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="200"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Product Image -->
                                    <Border Grid.Row="0" 
                                            Background="#F8F9FA"
                                            ClipToBounds="True"
                                            Height="200">
                                        <Grid>
                                            <!-- Изображение товара -->
                                            <Image Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="300"
                                                   MaxHeight="200">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource ImageConverter}">
                                                        <Binding Path="ImageData"/>
                                                        <Binding Path="ImagePath" FallbackValue=""/>
                                                    </MultiBinding>
                                                </Image.Source>
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Source}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            
                                            <!-- Placeholder если изображение отсутствует -->
                                            <Border Background="#E0E0E0"
                                                    Height="200"
                                                    Visibility="{Binding ImageData, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImagePath, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel VerticalAlignment="Center" 
                                                          HorizontalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Image" 
                                                                           Width="64" Height="64" 
                                                                           Foreground="#BDBDBD"
                                                                           HorizontalAlignment="Center"
                                                                           Margin="0,0,0,10"
                                                                           VerticalAlignment="Center"/>
                                                    <TextBlock Text="Нет изображения" 
                                                               Foreground="#9E9E9E"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Product Info -->
                                    <StackPanel Grid.Row="1" Margin="15">
                                        <TextBlock Text="{Binding Name}" 
                                                   FontSize="15" FontWeight="Bold" 
                                                   Margin="0,0,0,8" 
                                                   TextWrapping="Wrap"
                                                   Foreground="#2C3E50"
                                                   LineHeight="20"
                                                   MaxHeight="60"/>
                                        <TextBlock Text="{Binding CategoryName}" 
                                                   FontSize="12" 
                                                   Foreground="#7F8C8D" 
                                                   Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding ManufacturerName}" 
                                                   FontSize="12" 
                                                   Foreground="#7F8C8D" 
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="{Binding Price, StringFormat='{}{0:N2} BYN'}" 
                                                   FontSize="22" FontWeight="Bold" 
                                                   Foreground="#27AE60" 
                                                   Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <materialDesign:PackIcon Kind="PackageVariant" 
                                                                     Width="16" Height="16" 
                                                                     Margin="0,0,5,0"
                                                                     Foreground="#3498DB"/>
                                            <TextBlock Text="{Binding StockQuantity, StringFormat='В наличии: {0} шт.'}" 
                                                       FontSize="12"
                                                       Foreground="#34495E"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Add to Cart Button -->
                                    <Button Grid.Row="2"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="#3498DB"
                                            materialDesign:ButtonAssist.CornerRadius="0"
                                            Height="50"
                                            FontSize="14"
                                            FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CartPlus" Width="20" Height="20" Margin="0,0,8,0"/>
                                            <TextBlock Text="В корзину"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
