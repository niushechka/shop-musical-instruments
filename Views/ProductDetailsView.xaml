<Window x:Class="course_project_shop_musical_instruments.Views.ProductDetailsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:course_project_shop_musical_instruments.Helpers"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Детали товара"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Product Image -->
        <materialDesign:Card Grid.Column="0" 
                             materialDesign:ShadowAssist.ShadowDepth="Depth3"
                             Padding="20" 
                             Background="White"
                             Margin="0,0,20,0">
            <Border BorderBrush="#E0E0E0" 
                    BorderThickness="1" 
                    Background="#F8F9FA"
                    Height="400"
                    CornerRadius="5">
                <Grid>
                    <Image Source="{Binding ProductImage}" 
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MaxHeight="400"
                           MaxWidth="360">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProductImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <Border Background="#E0E0E0" 
                            Visibility="{Binding ProductImage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Image" 
                                                     Width="64" Height="64" 
                                                     Foreground="#BDBDBD"
                                                     HorizontalAlignment="Center"
                                                     Margin="0,0,0,10"/>
                            <TextBlock Text="Нет изображения" 
                                       Foreground="#9E9E9E"
                                       FontSize="12"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </materialDesign:Card>

        <!-- Product Details -->
        <materialDesign:Card Grid.Column="1" 
                             materialDesign:ShadowAssist.ShadowDepth="Depth3"
                             Padding="30" 
                             Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Product.Name}" 
                               FontSize="28" FontWeight="Bold" 
                               Margin="0,0,0,15"
                               Foreground="#2C3E50"
                               TextWrapping="Wrap"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Категория: " 
                                   FontWeight="SemiBold" 
                                   Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding Product.CategoryName}" 
                                   Foreground="#34495E"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Производитель: " 
                                   FontWeight="SemiBold" 
                                   Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding Product.ManufacturerName}" 
                                   Foreground="#34495E"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Артикул: " 
                                   FontWeight="SemiBold" 
                                   Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding Product.ArticleNumber}" 
                                   Foreground="#34495E"/>
                    </StackPanel>
                    
                    <Separator Margin="0,15,0,15"/>
                    
                    <!-- Price with Currency Conversion -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Цена:" 
                                   FontWeight="SemiBold" 
                                   FontSize="16"
                                   Margin="0,0,0,10"
                                   Foreground="#34495E"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock FontSize="32" FontWeight="Bold" 
                                       Foreground="#27AE60"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:F2} {1}">
                                        <Binding Path="ConvertedPrice"/>
                                        <Binding Path="SelectedCurrency"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <ComboBox ItemsSource="{Binding Currencies}"
                                      SelectedItem="{Binding SelectedCurrency}" 
                                      Width="100"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Product.Price, StringFormat='Оригинальная цена: {0:N2} BYN'}" 
                                   FontSize="12" 
                                   Foreground="#7F8C8D"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <Separator Margin="0,15,0,15"/>
                    
                    <TextBlock Text="Описание:" 
                               FontWeight="SemiBold" 
                               FontSize="16"
                               Margin="0,0,0,10"
                               Foreground="#34495E"/>
                    <TextBlock Text="{Binding Product.Description}" 
                               FontSize="14" 
                               Foreground="#2C3E50"
                               TextWrapping="Wrap"
                               LineHeight="24"
                               Margin="0,0,0,20"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="В наличии: " 
                                   FontWeight="SemiBold" 
                                   Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding Product.StockQuantity}" 
                                   Foreground="#27AE60"
                                   FontWeight="Bold"/>
                        <TextBlock Text=" шт." 
                                   Foreground="#7F8C8D"
                                   Margin="5,0,0,0"/>
                    </StackPanel>
                    
                    <Button Command="{Binding AddToCartCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#27AE60"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Height="50"
                            FontSize="18"
                            Margin="0,20,0,10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CartPlus" Width="24" Height="24" Margin="0,0,10,0" Foreground="White"/>
                            <TextBlock Text="Добавить в корзину" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Command="{Binding NavigateToCatalogCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Height="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Вернуться в каталог"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</Window>

